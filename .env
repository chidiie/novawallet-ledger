# Local development values only. A real deployment injects these from a secret
# manager; this file exists so `docker compose up` works from a clean checkout.
POSTGRES_DB=novawallet
POSTGRES_USER=novawallet
POSTGRES_PASSWORD=novawallet_dev_password

# Host port. 5433 rather than 5432 to avoid colliding with a locally installed
# PostgreSQL — see README.
POSTGRES_HOST_PORT=5433

API_HOST_PORT=8081

JWT_SIGNING_KEY=local-compose-signing-key-at-least-32-bytes-long
JWT_ISSUER=novawallet-mock-issuer
JWT_AUDIENCE=novawallet-api